{
  "name": "clear-2fa-otp",
  "version": "1.1.3",
  "private": true,
  "description": "An open-source authenticator for 2FA tokens.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "post-build": "bun run ./release-scripts/post-build.ts",
    "build": "vue-tsc --noEmit && vite build && bun run post-build",
    "build-firefox": "vue-tsc --noEmit && vite build && bun run post-build firefox",
    "rebuild": "bun run build && bun run ./release-scripts/create-release.ts rebuild",
    "build-source": "bun run ./release-scripts/create-source-archive.ts",
    "preview": "vite preview",
    "release": "bun run ./release-scripts/version-release.ts",
    "postversion": "git push",
    "pub": "bun run build && bun run release && bun run ./release-scripts/create-release.ts",
    "only-pub": "bun run build && bun run ./release-scripts/create-release.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@ionic/core": "^9.0.8",
    "@ionic/vue": "^9.0.8",
    "@ionic/vue-router": "^9.0.8",
    "@otplib/core": "^13.5.0",
    "@otplib/plugin-crypto-web": "^13.5.0",
    "@otplib/totp": "^13.5.0",
    "core-js": "^3.50.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@types/archiver": "8.0.0",
    "@types/bun": "^1.4.3",
    "@types/chrome": "0.3.5",
    "@types/jest": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "archiver": "8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "http-browserify": "^1.7.0",
    "https-browserify": "^1.0.0",
    "jest": "^30.5.2",
    "sass": "^1.105.1",
    "stream-browserify": "^3.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "util": "^0.12.5",
    "vite": "8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "disabledNativeDependencies": {
    "@capacitor/app": "^5.0.6",
    "@capacitor/core": "^5.2.3",
    "@capacitor/haptics": "^5.0.6",
    "@capacitor/keyboard": "^5.0.6",
    "@capacitor/status-bar": "^5.0.6"
  }
}